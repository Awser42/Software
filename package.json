{
  "name": "aliexpress-product-archiver",
  "version": "1.4.6",
  "description": "Desktop product archive tool with manual Chromium sign-in",
  "main": "src/bootstrap.js",
  "private": true,
  "author": "Product Archiver",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "browser:install": "playwright install chromium",
    "bundle:chromium": "node scripts/bundle-chromium.js",
    "build:update": "node scripts/build-update.js",
    "build:icons": "node scripts/build-icons.js",
    "build:win:lite": "node scripts/build-lite.js",
    "build:win": "npm run bundle:chromium && electron-builder --win nsis --x64 --publish never",
    "build:linux": "electron-builder --linux dir"
  },
  "dependencies": {
    "archiver": "7.0.1",
    "playwright": "1.64.1"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.15.3",
    "lucide-static": "1.61.0",
    "yauzl": "3.4.0"
  },
  "build": {
    "appId": "com.productarchiver.desktop",
    "productName": "AliExpress Product Archiver",
    "asar": true,
    "asarUnpack": [
      "node_modules/playwright/**",
      "node_modules/playwright-core/**"
    ],
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build-resources/chromium-compact",
        "to": "chromium",
        "filter": [
          "**/*",
          "!.links/**"
        ]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "zip"
      ],
      "signAndEditExecutable": false
    },
    "artifactName": "AliExpress-Product-Archiver-${version}-${os}-${arch}.${ext}",
    "electronLanguages": [
      "en-US"
    ],
    "compression": "maximum",
    "nsis": {
      "artifactName": "AliExpress-Product-Archiver-${version}-Setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
